{
  "name": "muse-invite-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:worker": "opennextjs-cloudflare build && node scripts/sanitize-worker-env.mjs",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy": "pnpm build:worker && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:local": "node --env-file=.env.local --import tsx scripts/local-db.ts",
    "db:seed:local": "node --env-file=.env.local --import tsx scripts/seed.ts --target local",
    "format": "prettier --write src tests/*.ts scripts/*.ts scripts/*.mjs next.config.ts open-next.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
