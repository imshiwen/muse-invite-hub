# Next.js local development only
APP_ENV=local
LOCAL_DB_URL=http://127.0.0.1:54329

# Generate three different random values, each at least 32 bytes.
LOCAL_DB_KEY=
APP_HMAC_KEY=
LOCAL_ADMIN_KEY=

# Optional country override for local consent-interface checks, e.g. DE or US.
LOCAL_TEST_COUNTRY=

# Keep unset/false by default. Set true only for local form-interface testing
# when no Turnstile widget is configured. This is never valid in production.
LOCAL_TURNSTILE_BYPASS=false

# Turnstile public site key is injected at build time; the secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=

# Leave empty until the real GA4 measurement ID is provided.
GA4_MEASUREMENT_ID=

# Production-only values are configured in Cloudflare's environment settings,
# not copied from this local template.
# DATABASE_URL=
# CF_ACCESS_ISSUER=
# CF_ACCESS_AUD=
# ADMIN_EMAIL=
# MAINTENANCE_SECRET=
